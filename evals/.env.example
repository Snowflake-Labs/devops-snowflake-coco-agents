# =============================================================================
# Snowflake Connection Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# See: https://github.com/snowflake-eng/cortex-code-eval/blob/main/CONNECTIONS.md

# Eval connection - injected into Docker containers for agent evaluation
SNOWFLAKE_CONNECTION_NAME=<your-connection-name>

# Admin connection - host-side connection for creating scratch schemas
SNOWFLAKE_ADMIN_CONNECTION_NAME=<your-connection-name>

# Optional: override the database used for scratch schemas
# SCRATCH_DATABASE=<your-database>
